var int: n := read(), i := 0, j := 0, swaps := 0
var arr<int, 1000>: a

while (i < n)
    a[i] := read()
    i := i + 1
endwhile

i := 0
while (i < n - 1)
    j := 0
    while (j < n - 1 - i)
        if (a[j] > a[j + 1])
            a[j], a[j + 1] := a[j + 1], a[j]
            swaps := swaps + 1
        endif
        j := j + 1
    endwhile
    i := i + 1
endwhile

print("swaps =", swaps)
i := 0
while (i < n)
    print(a[i])
    i := i + 1
endwhile
exit
