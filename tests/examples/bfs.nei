var int: n := read(), m := read(), start
var int: i := 0, u := 0, v := 0, cur := 0, head := 0, tail := 0
var arr<int, 1000000>: g
var arr<int, 1000>: dist, queue

while (i < m)
    u := read()
    v := read()
    g[u * n + v], g[v * n + u] := 1, 1
    i := i + 1
endwhile

start := read()

i := 0
while (i < n)
    dist[i] := -1
    i := i + 1
endwhile

dist[start] := 0
queue[tail] := start
tail := tail + 1

while (head < tail)
    cur := queue[head]
    head := head + 1
    v := 0
    while (v < n)
        if (g[cur * n + v] = 1 && dist[v] = -1)
            dist[v] := dist[cur] + 1
            queue[tail] := v
            tail := tail + 1
        endif
        v := v + 1
    endwhile
endwhile

i := 0
while (i < n)
    print("dist", i, "=", dist[i])
    i := i + 1
endwhile
exit